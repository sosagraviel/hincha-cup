# App under test (docker compose stack started by `make start` or by playwright.config.ts webServer)
BASE_URL=http://localhost:5173
TEST_ID_ATTRIBUTE=data-testid
# Local Firestore emulator used by the `freshData` reset fixture (local only: the fixture refuses non-local hosts)
FIRESTORE_EMULATOR_URL=http://127.0.0.1:8081
FIREBASE_PROJECT_ID=gritogol
# Command (run from the app folder, e2e/..) that re-seeds the emulator after the reset
SEED_COMMAND=make seed
